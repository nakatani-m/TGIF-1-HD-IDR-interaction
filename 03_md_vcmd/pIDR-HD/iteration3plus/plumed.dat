# vim:ft=plumed
#compute the distance between the three peptides
c1: COM ATOMS=768,770,780-782,784,799-801,803,816-818,820,832-834,836,843-845,847,857-859,861,881-883,885,901-903,905,920-922,924,934-936,938,944-946,948,968-970,972,992-994,996,1016-1018,1020,1035-1037,1039,1054-1056,1066,1068-1070,1072,1080-1082,1084,1097-1099,1101,1116-1118,1120,1140-1142,1144,1162-1164,1166,1174,1175 #46THR-68ASP
c2: COM ATOMS=1340,1342,1352,1353 #8SEP
c3: COM ATOMS=1415,1417,1427,1428 #13SEP
c4: COM ATOMS=1450,1452,1462,1463 #16SEP
d1: DISTANCE ATOMS=c1,c2
d2: DISTANCE ATOMS=c1,c3
d3: DISTANCE ATOMS=c1,c4
VIRTUAL_STATE_COUPLING ARG=d1,d2,d3 KAPPA=1000000  PARAMS=../params.dat STATE=state.dat DRIFT=1.0 LOGSTATE=ttp_v.out QRAWSTAT=qraw.dat QRAWSTAT_IS=qraw_is.dat VERBOSE=1 TRANSITCOUNT=transit_count.txt
PRINT ARG=d1,d2,d3 STRIDE=1000 FILE=distance.dat
